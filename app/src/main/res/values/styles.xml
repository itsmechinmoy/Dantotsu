<resources>

    <style name="Widget.Dantotsu.AppWidget.Container" parent="android:Widget">
        <item name="android:id">@android:id/background</item>
        <item name="android:background">?android:attr/colorBackground</item>
    </style>

    <style name="Widget.Dantotsu.AppWidget.InnerView" parent="android:Widget">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="ExoMediaButton">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">#FFFFFFFF</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="ExoMediaButton.Play" parent="ExoMediaButton" />

    <style name="ExoMediaButton.Pause" parent="ExoMediaButton" />
</resources>